#pragma once

// Copy this file to Secrets.h (already in .gitignore -- never commit
// real credentials) before flashing over USB for the first time on
// each physical device.
//
// WIFI_SSID / WIFI_PASSWORD: the one fixed venue network this device
// connects to (see NetworkManager.h -- no multi-network failover).
// App::begin() writes these into SettingsStorage (NVS) once, on first
// boot only, if no SSID is already saved -- so editing this file
// after a device's first boot has no effect on a device that's
// already booted; use WifiSetupMenu or WifiPortal instead (see
// CLAUDE.md's "WiFi & OTA" section), or clear NVS.
//
// Leaving WIFI_SSID/WIFI_PASSWORD empty (the default here) is
// intentional and supported: on first boot with no saved SSID, App
// auto-opens WifiPortal (the ESP's own setup access point) instead of
// attempting to connect with nothing -- so a fresh device can be
// configured entirely from a phone, without ever needing to edit this
// file for WiFi specifically. Fill them in only if you'd rather
// pre-configure the network at flash time.
//
// OTA_PASSWORD / WIFI_PORTAL_PASSWORD do need real values, though --
// an unauthenticated OTA endpoint lets anyone on the network overwrite
// this device's firmware, and an open (unprotected) setup access
// point lets anyone nearby redirect the device onto a network of
// their choosing.
#define WIFI_SSID ""
#define WIFI_PASSWORD ""
#define OTA_PASSWORD "pick-a-real-ota-password"
#define WIFI_PORTAL_PASSWORD "pick-a-real-portal-password"
